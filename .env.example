# Exemplo sem credenciais; não substitui a configuração ativa da Netlify.
# Preencha segredos somente nas configurações protegidas do provedor.
EVO_API_ACCESS_TOKEN=
EVO_PIPELINE_NAME=Vendas EixoWeb
EVO_STAGE_NAME=Novo Lead
# Substitua pela origem HTTPS exata da implantação autorizada, sem barra final.
EIXO_ALLOWED_ORIGINS=https://example.netlify.app
# Mantenha false em novos ambientes até a ativação ser autorizada.
EIXO_LEADS_ENABLED=false
